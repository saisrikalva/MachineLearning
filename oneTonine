from sklearn.linear_model import LinearRegression
X = [
    [1000, 2, 5],
    [1200, 2, 4],
    [1500, 3, 5],
    [1800, 3, 3],
    [2000, 4, 2],
    [2500, 4, 1]
]
y = [95000, 108000, 152500, 181500, 219000, 250500]
model = LinearRegression()
model.fit(X, y)
prediction = model.predict([[1500, 3, 5]])
print("Predicted House Price:", round(prediction[0], 2))


