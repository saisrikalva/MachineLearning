from scipy.stats import linregress
x = [1, 2, 3, 4, 5]
y = [2, 4, 5, 4, 5]
model = linregress(x, y)
print("Slope:", round(model.slope, 2))
print("Intercept:", round(model.intercept, 2))
prediction = model.slope * 6 + model.intercept
print("Prediction:", round(prediction, 2))


